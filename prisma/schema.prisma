// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// SHARED
// ─────────────────────────────────────────

model RecurrenceRule {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id           Int       @id @default(autoincrement())
  frequency    String    // 'daily' | 'weekly' | 'monthly'
  intervalN    Int       @default(1)
  dayOfMonth   Int?      // para monthly en día específico
  endsOn       DateTime?
  createdAt    DateTime  @default(now())

  events       CalendarEvent[]
  tasks        Task[]

  @@index([userId])
}

// ─────────────────────────────────────────
// FINANZAS
// ─────────────────────────────────────────

model FinanceSource {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id           Int       @id @default(autoincrement())
  name         String    // 'daily' | 'savings'
  balance      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())

  transactions FinanceTransaction[]
  debts        FinanceDebt[]

  @@index([userId])
}

model FinanceTransaction {
  id        Int       @id @default(autoincrement())
  type      String    // 'expense' | 'income'
  amount    Decimal   @db.Decimal(12, 2)
  category  String
  sourceId  Int
  date      DateTime  @default(now()) @db.Date
  notes     String?
  createdAt DateTime  @default(now())

  source    FinanceSource @relation(fields: [sourceId], references: [id])
}

model FinanceDebt {
  id          Int       @id @default(autoincrement())
  direction   String    // 'i_owe' | 'they_owe_me'
  person      String
  reason      String
  amount      Decimal   @db.Decimal(12, 2)
  amountPaid  Decimal   @default(0) @db.Decimal(12, 2)
  sourceId    Int
  date        DateTime  @default(now()) @db.Date
  isSettled   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  source      FinanceSource    @relation(fields: [sourceId], references: [id])
  payments    FinanceDebtPayment[]
}

model FinanceDebtPayment {
  id        Int      @id @default(autoincrement())
  debtId    Int
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime @default(now()) @db.Date
  createdAt DateTime @default(now())

  debt      FinanceDebt @relation(fields: [debtId], references: [id])
}

model FinanceAsset {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id         Int      @id @default(autoincrement())
  title      String
  quantity   Decimal  @db.Decimal(12, 4)
  unit       String?
  priceEach  Decimal? @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Líneas de crédito (ej. tarjetas/créditos de libre inversión) — distinto de
// FinanceDebt: no es plata que le debes a una persona, es un cupo con una
// entidad del que retiras y al que abonas. `creditLimit` es opcional porque
// no toda línea de crédito tiene un tope fijo conocido.
model FinanceCreditLine {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id          Int      @id @default(autoincrement())
  name        String
  creditLimit Decimal? @db.Decimal(12, 2)
  // Deuda inicial opcional. Null = línea sin seguimiento de deuda (comportamiento
  // anterior: los pagos liberan cupo).
  totalDebt   Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  movements   FinanceCreditMovement[]

  @@index([userId])
}

model FinanceCreditMovement {
  id           Int      @id @default(autoincrement())
  creditLineId Int
  type         String   // 'withdrawal' | 'payment'
  amount       Decimal  @db.Decimal(12, 2)
  date         DateTime @default(now()) @db.Date
  notes        String?
  createdAt    DateTime @default(now())

  creditLine   FinanceCreditLine @relation(fields: [creditLineId], references: [id])
}

// ─────────────────────────────────────────
// RACHAS
// ─────────────────────────────────────────

model Streak {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int      @id @default(autoincrement())
  name      String
  color     String   @default("#8b5cf6")
  mode      String   // 'daily' | 'alternate' (día sí, día no)
  createdAt DateTime @default(now())

  checkins  StreakCheckin[]

  @@index([userId])
}

model StreakCheckin {
  id       Int      @id @default(autoincrement())
  streakId Int
  date     DateTime @db.Date

  streak   Streak   @relation(fields: [streakId], references: [id], onDelete: Cascade)

  @@unique([streakId, date])
}

// ─────────────────────────────────────────
// NUTRICIÓN
// ─────────────────────────────────────────

model NutritionFoodCache {
  id          Int      @id @default(autoincrement())
  offId       String?  @unique
  name        String
  kcal100g    Decimal? @db.Decimal(8, 2)
  protein100g Decimal? @db.Decimal(8, 2)
  carbs100g   Decimal? @db.Decimal(8, 2)
  fat100g     Decimal? @db.Decimal(8, 2)
  cachedAt    DateTime @default(now())

  mealItems   NutritionMealItem[]
}

model NutritionFavorite {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id           Int      @id @default(autoincrement())
  name         String
  kcal100g     Decimal  @db.Decimal(8, 2)
  protein100g  Decimal  @db.Decimal(8, 2)
  carbs100g    Decimal  @db.Decimal(8, 2)
  fat100g      Decimal  @db.Decimal(8, 2)
  defaultUnit  String   @default("g") // 'g' | 'ml' | 'unit'
  kcalPerUnit  Decimal? @db.Decimal(8, 2)
  createdAt    DateTime @default(now())

  mealItems    NutritionMealItem[]

  @@index([userId])
}

model NutritionMealLog {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  mealType  String   // 'breakfast' | 'lunch' | 'dinner' | 'snack'
  createdAt DateTime @default(now())

  items     NutritionMealItem[]

  @@index([userId])
}

model NutritionMealItem {
  id          Int      @id @default(autoincrement())
  mealLogId   Int
  foodName    String
  foodCacheId Int?
  favoriteId  Int?
  amountG     Decimal  @db.Decimal(8, 2)
  state       String   @default("unknown") // 'raw' | 'cooked' | 'unknown'
  kcal        Decimal  @db.Decimal(8, 2)
  proteinG    Decimal  @db.Decimal(8, 2)
  carbsG      Decimal  @db.Decimal(8, 2)
  fatG        Decimal  @db.Decimal(8, 2)
  isEstimated Boolean  @default(false)
  createdAt   DateTime @default(now())

  mealLog     NutritionMealLog   @relation(fields: [mealLogId], references: [id])
  foodCache   NutritionFoodCache? @relation(fields: [foodCacheId], references: [id])
  favorite    NutritionFavorite?  @relation(fields: [favoriteId], references: [id])
}

/// Receta guardada: lista de ingredientes con gramos y macros ya escalados.
/// Los items no referencian favoritos/caché: son una foto de los macros al guardar.
model NutritionRecipe {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int      @id @default(autoincrement())
  name      String
  mealType  String?  // sugerencia: 'breakfast' | 'lunch' | 'dinner' | 'snack'
  createdAt DateTime @default(now())

  // Tablero de recetas: agrupación, preparación y costo.
  groupName   String?  // p. ej. "Desayunos con avena"; las del mismo grupo son intercambiables
  description String?
  servings    Int      @default(1) // porciones que rinde
  prepMinutes Int?
  steps       Json?    // [{ text: string, minutes?: number }]
  storage     String?  // cómo guardarla
  fridgeDays  Int?
  tips        String[] @default([])
  costCop     Int?     // costo por porción (COP)
  // Macros por porción declarados; si existen sustituyen la suma de ingredientes.
  kcal        Decimal? @db.Decimal(8, 2)
  proteinG    Decimal? @db.Decimal(8, 2)
  carbsG      Decimal? @db.Decimal(8, 2)
  fatG        Decimal? @db.Decimal(8, 2)

  items     NutritionRecipeItem[]

  @@index([userId])
}

model NutritionRecipeItem {
  id          Int      @id @default(autoincrement())
  recipeId    Int
  foodName    String
  amountG     Decimal  @db.Decimal(8, 2)
  state       String   @default("unknown") // 'raw' | 'cooked' | 'unknown'
  kcal        Decimal  @db.Decimal(8, 2)
  proteinG    Decimal  @db.Decimal(8, 2)
  carbsG      Decimal  @db.Decimal(8, 2)
  fatG        Decimal  @db.Decimal(8, 2)
  isEstimated Boolean  @default(false)
  quantity    Decimal? @db.Decimal(8, 2) // cantidad tal como se compra/cocina (4 und, 0.5 lata…)
  unit        String?
  costCop     Int?
  store       String?

  recipe      NutritionRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model NutritionGoal {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int      @id @default(autoincrement())
  kcal      Int
  proteinG  Int
  carbsG    Int
  fatG      Int
  updatedAt DateTime @default(now())

  @@index([userId])
}

model NutritionWeightLog {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int      @id @default(autoincrement())
  weightKg  Decimal  @db.Decimal(5, 2)
  date      DateTime @db.Date
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model NutritionWaterLog {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  amountMl  Int      @default(250)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────
// GYM
// ─────────────────────────────────────────

model GymRoutine {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  exercises GymRoutineExercise[]
  workouts  GymWorkout[]

  @@index([userId])
}

model GymRoutineExercise {
  id         Int      @id @default(autoincrement())
  routineId  Int
  name       String
  type       String   // 'weight' | 'bodyweight' | 'cardio'
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  routine    GymRoutine @relation(fields: [routineId], references: [id])
}

model GymWorkout {
  id         Int       @id @default(autoincrement())
  routineId  Int
  date       DateTime  @db.Date
  notes      String?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  routine    GymRoutine      @relation(fields: [routineId], references: [id])
  sets       GymWorkoutSet[]
}

model GymWorkoutSet {
  id            Int      @id @default(autoincrement())
  workoutId     Int
  exerciseName  String
  exerciseType  String
  setNumber     Int
  reps          Int?
  weightKg      Decimal? @db.Decimal(6, 2)
  durationSecs  Int?
  distanceKm    Decimal? @db.Decimal(6, 3)
  notes         String?
  createdAt     DateTime @default(now())

  workout       GymWorkout @relation(fields: [workoutId], references: [id])
}

model GymMeasurement {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  chestCm   Decimal? @db.Decimal(5, 2)
  waistCm   Decimal? @db.Decimal(5, 2)
  hipsCm    Decimal? @db.Decimal(5, 2)
  armsCm    Decimal? @db.Decimal(5, 2)
  thighsCm  Decimal? @db.Decimal(5, 2)
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────
// CALENDARIO
// ─────────────────────────────────────────

model CalendarEvent {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id             Int       @id @default(autoincrement())
  title          String
  date           DateTime  @db.Date
  time           DateTime  @db.Time
  category       String    // 'medical' | 'work' | 'personal' | 'study'
  location       String?
  meetingLink    String?
  notes          String?
  recurrenceId   Int?
  source         String    @default("manual") // 'manual' | 'task'
  sourceTaskId   Int?
  createdAt      DateTime  @default(now())

  recurrence     RecurrenceRule? @relation(fields: [recurrenceId], references: [id])
  reminders      CalendarReminder[]

  @@index([userId])
}

model CalendarReminder {
  id          Int      @id @default(autoincrement())
  eventId     Int
  remindType  String   // 'same_day' | 'day_before' | 'custom'
  remindTime  DateTime @db.Time
  daysBefore  Int      @default(0)
  isSent      Boolean  @default(false)
  createdAt   DateTime @default(now())

  event       CalendarEvent @relation(fields: [eventId], references: [id])
}

// ─────────────────────────────────────────
// TAREAS
// ─────────────────────────────────────────

model TaskLabel {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int      @id @default(autoincrement())
  name      String
  color     String?
  createdAt DateTime @default(now())

  tasks     TaskLabelAssignment[]

  @@unique([userId, name])
  @@index([userId])
}

model Task {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id              Int       @id @default(autoincrement())
  title           String
  description     String?
  urgent          Boolean   @default(false)
  important       Boolean   @default(false)
  status          String    @default("pending") // 'pending' | 'in_progress' | 'done'
  date            DateTime? @db.Date
  time            DateTime? @db.Time
  recurrenceId    Int?
  calendarEventId Int?
  doneAt          DateTime?
  createdAt       DateTime  @default(now())

  recurrence      RecurrenceRule? @relation(fields: [recurrenceId], references: [id])
  labels          TaskLabelAssignment[]

  @@index([userId])
}

model TaskLabelAssignment {
  taskId   Int
  labelId  Int

  task     Task      @relation(fields: [taskId], references: [id])
  label    TaskLabel @relation(fields: [labelId], references: [id])

  @@id([taskId, labelId])
}

// ─────────────────────────────────────────
// PROYECTOS
// ─────────────────────────────────────────

model ProjectCategory {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())

  projects  Project[]

  @@unique([userId, name])
  @@index([userId])
}

model Project {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      String    @default("idea")
  // 'idea' | 'en_progreso' | 'pausado' | 'descartado' | 'completado'
  viability   String?
  // null en fase 1 — 'muy_viable' | 'viable' | 'poco_viable' en fase 2
  categoryId  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category    ProjectCategory?     @relation(fields: [categoryId], references: [id])
  tags        ProjectTagAssignment[]
  notes       ProjectNote[]
  links       ProjectLink[]

  @@index([userId])
}

model ProjectTag {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  projects  ProjectTagAssignment[]

  @@unique([userId, name])
  @@index([userId])
}

model ProjectTagAssignment {
  projectId Int
  tagId     Int

  project   Project    @relation(fields: [projectId], references: [id])
  tag       ProjectTag @relation(fields: [tagId], references: [id])

  @@id([projectId, tagId])
}

model ProjectNote {
  id        Int      @id @default(autoincrement())
  projectId Int
  content   String
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id])
}

model ProjectLink {
  id        Int      @id @default(autoincrement())
  projectId Int
  title     String?
  url       String
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id])
}

// ── Blog (notas del grupo de investigación, etc.) ─────────────────────────
model BlogPost {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  tags      String[]
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  links     BlogLink[]

  @@index([userId])
}

/// "Docs" de una entrada: enlaces a documentos (Drive, Notion, PDFs, etc.)
model BlogLink {
  id        Int      @id @default(autoincrement())
  postId    Int
  title     String?
  url       String
  createdAt DateTime @default(now())

  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// ── Conceptos (glosario personal) ─────────────────────────────────────────
model Concept {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id         Int      @id @default(autoincrement())
  term       String
  definition String
  topic      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

/// Lista de productos del recetario (qué comprar y a qué precio).
model NutritionProduct {
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  id          Int      @id @default(autoincrement())
  name        String
  category    String?
  quantity    Decimal? @db.Decimal(8, 2)
  unit        String?
  priceCop    Int
  store       String   // 'D1' | 'Tienda de barrio'
  priceType   String?  // 'publicado' | 'estimado'
  note        String?
  url         String?
  recipeCodes String[] @default([])
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ── Empleo ────────────────────────────────────────────────────────────────
/// Portal de trabajo donde tienes (o quieres tener) cuenta y perfil.
/// No guarda contraseñas: solo el correo/usuario con el que te registraste.
model JobPortal {
  id        Int      @id @default(autoincrement())
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId    String   @default("")
  name      String
  url       String?
  account   String?  // correo o usuario con el que te registraste
  status    String   @default("pendiente") // 'pendiente' | 'cuenta_creada' | 'perfil_completo'
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Una postulación: empresa, cargo, por dónde te postulaste y en qué va.
model JobApplication {
  id        Int       @id @default(autoincrement())
  userId    String    @default("")
  company   String
  position  String
  url       String?
  source    String?   // dónde te postulaste (LinkedIn, un portal, referido…)
  status    String    @default("postulado")
  // 'postulado' | 'en_revision' | 'entrevista' | 'prueba' | 'oferta' | 'rechazado' | 'sin_respuesta'
  appliedAt DateTime  @db.Date
  salary    String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

// ── Tokens personales (Claude Desktop / MCP) ──────────────────────────────
/// Token para que un cliente externo (el servidor MCP) llame a la API como el
/// usuario. Solo se guarda el hash SHA-256: el token en claro se muestra una vez.
model ApiToken {
  id         Int       @id @default(autoincrement())
  /// Dueño de la fila (auth.users.id de Supabase). Lo rellena lib/db.ts solo.
  userId     String    @default("")
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
